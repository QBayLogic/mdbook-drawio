<mxfile host="mdbook-drawio">
  <diagram id="request" name="Request">
    <mxGraphModel grid="1" gridSize="10" page="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="base" value="Browser, server and database" parent="0"/>
        <mxCell id="browser" value="Browser" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#666666;" vertex="1" parent="base"><mxGeometry x="0" y="0" width="120" height="60" as="geometry"/></mxCell>
        <mxCell id="server" value="Server" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#d5e8d4;strokeColor=#666666;" vertex="1" parent="base"><mxGeometry x="260" y="0" width="120" height="60" as="geometry"/></mxCell>
        <mxCell id="db" value="Database" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#fff2cc;strokeColor=#666666;" vertex="1" parent="base"><mxGeometry x="520" y="0" width="120" height="60" as="geometry"/></mxCell>
        <mxCell id="l1" value="The browser sends a request" parent="0"/>
        <mxCell id="req" value="GET /page" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#6c8ebf;fontSize=13;labelBackgroundColor=default;exitX=1;exitY=0.3;entryX=0;entryY=0.3;flowAnimation=1;" edge="1" parent="l1" source="browser" target="server"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="l2" value="The server queries the database" parent="0"/>
        <mxCell id="query" value="SELECT" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#82b366;fontSize=13;labelBackgroundColor=default;exitX=1;exitY=0.3;entryX=0;entryY=0.3;flowAnimation=1;" edge="1" parent="l2" source="server" target="db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="l3" value="The database returns rows" parent="0"/>
        <mxCell id="rows" value="rows" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#d6b656;fontSize=13;labelBackgroundColor=default;exitX=0;exitY=0.7;entryX=1;entryY=0.7;dashed=1;" edge="1" parent="l3" source="db" target="server"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="l4" value="The server responds with HTML" parent="0"/>
        <mxCell id="resp" value="200 OK" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#6c8ebf;fontSize=13;labelBackgroundColor=default;exitX=0;exitY=0.7;entryX=1;entryY=0.7;dashed=1;" edge="1" parent="l4" source="server" target="browser"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
